// Template for custom CMake user presets.
// Set "COPY_PLUGIN_BASE_PATH" to your mod folder in MO2 or your Fallout 4 VR Data folder.
// Support multiple paths separated by semicolons (i.e. "<path1>;<path2>").
// Leave COMMON_LIB_F4VR_PATH empty to use the canonical workspace CommonLibF4VR.
// Set it only when intentionally overriding that dependency.
// Rename the file to 'CMakeUserPresets.json' (it is in .gitignore to keep it local to you).
// Remove this comment block.
// Fast plugin iteration copies ROCK.dll/ROCK.pdb to COPY_PLUGIN_BASE_PATH/F4SE/Plugins.
// Set ROCK_SETUP_WIZARD_PREVIEW_COPY_PATH to a folder to get a copy of the setup wizard
// preview (ROCKSetupWizardPreview.exe) there after each build; leave it empty for none.
// Tests share build-fast but are built only on request.
// Run:
// cmake --preset custom-fast
// cmake --build build-fast --config Release --target ROCK
// cmake --build build-fast --config Release --target ROCKPolicyTestBinaries
// ctest --test-dir build-fast -C Release --output-on-failure

{
  "version": 3,
  "configurePresets": [
    {
      "name": "custom-fast",
      "cacheVariables": {
        "POST_BUILD_COPY_PLUGIN": true,
        "COPY_PLUGIN_BASE_PATH": "[MO2 modlist folder]/mods/[my mod] OR [Fallout 4 VR game path]/Data",
        "ROCK_SETUP_WIZARD_PREVIEW_COPY_PATH": "",
        "COMMON_LIB_F4VR_PATH": ""
      },
      "inherits": "fast"
    },
    {
      "name": "custom-release",
      "cacheVariables": {
        "COMMON_LIB_F4VR_PATH": ""
      },
      "inherits": "release"
    }
  ]
}
