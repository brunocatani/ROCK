{
  "bindings": {
    "/actions/legacy": {
      "haptics": [
        { "output": "/actions/legacy/out/left_haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/legacy/out/right_haptic", "path": "/user/hand/right/output/haptic" }
      ],
      "poses": [
        { "output": "/actions/legacy/in/Left_Pose", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/legacy/in/Right_Pose", "path": "/user/hand/right/pose/raw" }
      ],
      "sources": [
        { "path": "/user/hand/left/input/system", "mode": "button", "inputs": { "click": { "output": "/actions/legacy/in/left_system_press" } } },
        { "path": "/user/hand/right/input/system", "mode": "button", "inputs": { "click": { "output": "/actions/legacy/in/right_system_press" } } },

        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "parameters": { "haptic_amplitude": "0" },
          "inputs": { "pull": { "output": "/actions/legacy/in/left_axis1_value" }, "touch": { "output": "/actions/legacy/in/left_axis1_touch" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "button",
          "parameters": { "click_activate_threshold": "0.55", "click_deactivate_threshold": "0.5", "haptic_amplitude": "0" },
          "inputs": { "click": { "output": "/actions/legacy/in/left_axis1_press" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "parameters": { "haptic_amplitude": "0" },
          "inputs": { "pull": { "output": "/actions/legacy/in/right_axis1_value" }, "touch": { "output": "/actions/legacy/in/right_axis1_touch" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "button",
          "parameters": { "click_activate_threshold": "0.55", "click_deactivate_threshold": "0.5", "haptic_amplitude": "0" },
          "inputs": { "click": { "output": "/actions/legacy/in/right_axis1_press" } } },

        { "path": "/user/hand/left/input/thumbstick", "mode": "joystick",
          "inputs": { "click": { "output": "/actions/legacy/in/left_axis0_press" }, "position": { "output": "/actions/legacy/in/left_axis0_value" }, "touch": { "output": "/actions/legacy/in/left_axis0_touch" } } },
        { "path": "/user/hand/right/input/thumbstick", "mode": "joystick",
          "inputs": { "click": { "output": "/actions/legacy/in/right_axis0_press" }, "position": { "output": "/actions/legacy/in/right_axis0_value" }, "touch": { "output": "/actions/legacy/in/right_axis0_touch" } } },

        { "path": "/user/hand/left/input/grip", "mode": "button",
          "parameters": { "click_activate_threshold": "0.8", "force_input": "force", "haptic_amplitude": "0" },
          "inputs": { "click": { "output": "/actions/legacy/in/left_grip_press" }, "touch": { "output": "/actions/legacy/in/left_grip_touch" } } },
        { "path": "/user/hand/left/input/grip", "mode": "trigger", "parameters": { "haptic_amplitude": "0" },
          "inputs": { "pull": { "output": "/actions/legacy/in/left_axis2_value1" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button",
          "parameters": { "click_activate_threshold": "0.8", "force_input": "force", "haptic_amplitude": "0" },
          "inputs": { "click": { "output": "/actions/legacy/in/right_grip_press" }, "touch": { "output": "/actions/legacy/in/right_grip_touch" } } },
        { "path": "/user/hand/right/input/grip", "mode": "trigger", "parameters": { "haptic_amplitude": "0" },
          "inputs": { "pull": { "output": "/actions/legacy/in/right_axis2_value1" } } },

        { "path": "/user/hand/left/input/a", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/left_a_press" }, "touch": { "output": "/actions/legacy/in/left_a_touch" } } },
        { "path": "/user/hand/left/input/b", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/left_applicationmenu_press" }, "touch": { "output": "/actions/legacy/in/left_applicationmenu_touch" } } },
        { "path": "/user/hand/right/input/a", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/right_a_press" }, "touch": { "output": "/actions/legacy/in/right_a_touch" } } },
        { "path": "/user/hand/right/input/b", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/right_applicationmenu_press" }, "touch": { "output": "/actions/legacy/in/right_applicationmenu_touch" } } }
      ]
    }
  },
  "category": "legacy",
  "controller_type": "knuckles",
  "description": "ROCK: Valve Index controllers in the Quest/Touch button layout ROCK expects. A/B are A/X and B/Y, grip squeeze grabs, the thumbstick is the stick, the trackpad is unused. Fallout 4 VR sees an Oculus Touch system.",
  "name": "ROCK - Index as Touch",
  "options": {
    "mirror_actions": false,
    "simulated_controller_type": "oculus_touch",
    "simulate_rendermodel": "name_only"
  },
  "simulated_actions": []
}
